#!/usr/bin/with-contenv bash
set -e
install -d -o abc -g abc /config/Desktop
if [[ ! -f /config/Desktop/run-api-gateway_v1.0.5_zh-cn.eext ]]; then
  install -o abc -g abc -m 0644 /opt/run-api-gateway_v1.0.5_zh-cn.eext /config/Desktop/
fi
if [[ ! -f /config/Desktop/README-EasyEDA-MCP.txt ]]; then
  cat > /config/Desktop/README-EasyEDA-MCP.txt <<'TXT'
嘉立创EDA MCP 首次使用：
1. 按官方提示完成客户端激活并登录。
2. 在扩展管理器导入同目录的 run-api-gateway_v1.0.5_zh-cn.eext。
3. 勾选 Run API Gateway 的“允许外部交互”。
4. 在 Hermes Studio 调用 easyeda_status 检查连接。

官方扩展：https://github.com/easyeda/eext-run-api-gateway
TXT
  chown abc:abc /config/Desktop/README-EasyEDA-MCP.txt
fi
